# 普通 configure 只选择并验证固定翻译缓存；Python、依赖安装及转换必须由用户显式准备。
include("${CMAKE_CURRENT_LIST_DIR}/OpenSTModelCache.cmake")

# 校验目录链没有符号链接/重解析跳转，实际路径仍位于给定缓存根。
# 入参：cache 为受限根，path 为已有候选路径。返回：输出变量为安全状态。
function(open_st_translation_cache_path cache path result)
    set(safe FALSE)
    if(EXISTS "${path}" AND NOT IS_SYMLINK "${path}")
        file(REAL_PATH "${cache}" real_cache)
        file(REAL_PATH "${path}" real_path)
        cmake_path(IS_PREFIX real_cache "${real_path}" NORMALIZE inside)
        if(inside)
            set(safe TRUE)
            set(current "${path}")
            while(NOT current STREQUAL cache)
                if(IS_SYMLINK "${current}")
                    set(safe FALSE)
                    break()
                endif()
                get_filename_component(parent "${current}" DIRECTORY)
                if(parent STREQUAL current)
                    set(safe FALSE)
                    break()
                endif()
                set(current "${parent}")
            endwhile()
        endif()
    endif()
    set(${result} "${safe}" PARENT_SCOPE)
endfunction()

# 唯一缓存选择/整套校验入口，显式准备复用此函数验证候选，不能另定信任值。
# 入参：root 为项目根，candidate 可指定尚未发布的整套目录；空值读取 active 或旧缓存。
# 返回：valid、selected、reason 三个输出变量；active 损坏不会退回旧模型。
function(open_st_select_translation_models root candidate valid selected reason)
    set(cache "${root}/.cache/translation-models")
    set(problem "")
    set(chosen "${candidate}")
    if(IS_SYMLINK "${root}/.cache" OR IS_SYMLINK "${cache}")
        set(problem "缓存根不能是符号链接或重解析目录")
    elseif(chosen STREQUAL "")
        set(pointer "${cache}/active.txt")
        if(EXISTS "${pointer}" OR IS_SYMLINK "${pointer}")
            if(IS_SYMLINK "${pointer}" OR IS_DIRECTORY "${pointer}")
                set(problem "active.txt 必须是普通文件")
            else()
                file(SIZE "${pointer}" pointer_size)
                if(pointer_size GREATER 80)
                    set(problem "active.txt 格式无效")
                else()
                    file(READ "${pointer}" identity)
                    string(STRIP "${identity}" identity)
                    string(LENGTH "${identity}" identity_length)
                    if(NOT identity_length EQUAL 32 OR NOT identity MATCHES "^[0-9a-f]+$")
                        set(problem "active.txt 仅允许一个32位小写十六进制ID")
                    else()
                        set(chosen "${cache}/packs/${identity}")
                    endif()
                endif()
            endif()
        else()
            # 兼容现有已验证缓存；显式准备永远不再覆盖这些目录。
            set(chosen "${cache}")
        endif()
    endif()
    if(problem STREQUAL "")
        open_st_translation_cache_path("${cache}" "${chosen}" safe)
        if(NOT safe OR NOT IS_DIRECTORY "${chosen}")
            set(problem "模型目录缺失或存在重解析/路径逃逸")
        endif()
    endif()
    if(problem STREQUAL "")
        file(READ "${root}/packaging/translation/models.json" manifest)
        string(JSON model_count LENGTH "${manifest}" models)
        math(EXPR model_last "${model_count} - 1")
        foreach(index RANGE ${model_last})
            string(JSON direction GET "${manifest}" models ${index} direction)
            if(NOT direction MATCHES "^(en-zh|zh-en)$")
                message(FATAL_ERROR "翻译模型清单方向无效")
            endif()
            string(JSON count LENGTH "${manifest}" models ${index} files)
            math(EXPR last "${count} - 1")
            foreach(f RANGE ${last})
                foreach(field file sha256 size)
                    string(JSON expected_${field} GET "${manifest}" models ${index} files ${f} ${field})
                endforeach()
                get_filename_component(name "${expected_file}" NAME)
                if(NOT expected_file STREQUAL "resources/translation/${direction}/${name}")
                    message(FATAL_ERROR "翻译模型清单路径无效")
                endif()
                set(path "${chosen}/${direction}/${name}")
                open_st_translation_cache_path("${cache}" "${path}" safe)
                if(safe)
                    open_st_model_file_matches("${path}" "${expected_sha256}" "${expected_size}" matches)
                else()
                    set(matches FALSE)
                endif()
                if(NOT matches)
                    set(problem "固定模型文件缺失、重解析或校验失败：${direction}/${name}")
                    break()
                endif()
            endforeach()
            if(NOT problem STREQUAL "")
                break()
            endif()
        endforeach()
    endif()
    if(problem STREQUAL "")
        set(${valid} TRUE PARENT_SCOPE)
    else()
        set(${valid} FALSE PARENT_SCOPE)
    endif()
    set(${selected} "${chosen}" PARENT_SCOPE)
    set(${reason} "${problem}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    # convert_models.py 的只读校验子进程返回固定三行报告，不调用 Python 或安装任何依赖。
    if(NOT DEFINED OPEN_ST_TRANSLATION_ROOT OR NOT DEFINED OPEN_ST_TRANSLATION_REPORT)
        message(FATAL_ERROR "仅支持显式准备工具提供 root/report 的只读缓存检查")
    endif()
    open_st_select_translation_models("${OPEN_ST_TRANSLATION_ROOT}" "${OPEN_ST_TRANSLATION_CANDIDATE}"
        ready selected problem)
    file(WRITE "${OPEN_ST_TRANSLATION_REPORT}" "${ready}\n${selected}\n${problem}\n")
else()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${PROJECT_SOURCE_DIR}/packaging/translation/models.json"
        "${PROJECT_SOURCE_DIR}/.cache/translation-models/active.txt")
    open_st_select_translation_models("${PROJECT_SOURCE_DIR}" "" ready OPEN_ST_TRANSLATION_MODEL_CACHE problem)
    if(NOT ready)
        message(FATAL_ERROR
            "本地翻译模型缓存不可用：${problem}\n"
            "请先显式运行：python packaging/translation/convert_models.py --root .\n"
            "准备工具需要清单指定的 Python；可用 --cmake 指定 CMake。普通 configure 不安装或转换模型。")
    endif()
endif()
