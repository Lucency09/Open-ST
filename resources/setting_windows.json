{
  "schemaVersion": 1,
  "window": {
    "titleKey": "settings.title",
    "initialSize": [
      600,
      420
    ],
    "minSize": [
      480,
      280
    ],
    "resizable": true
  },
  "pages": [
    {
      "id": "general",
      "titleKey": "settings.general",
      "content": {
        "type": "column",
        "id": "generalContent",
        "padding": 16,
        "gap": 12,
        "children": [
          {
            "type": "select",
            "id": "languageSelector",
            "labelKey": "settings.language.label",
            "width": "fill"
          },
          {
            "type": "text",
            "id": "languageHelp",
            "textKey": "settings.language.help"
          },
          {
            "type": "checkbox",
            "id": "startupEnabled",
            "labelKey": "settings.startup.label"
          },
          {
            "type": "text",
            "id": "startupStatus",
            "textKey": "settings.startup.status"
          },
          {
            "type": "button",
            "id": "startupRepairButton",
            "textKey": "settings.startup.repair"
          }
        ]
      }
    },
    {
      "id": "hotkeys",
      "titleKey": "settings.hotkeys",
      "content": {
        "type": "column",
        "id": "hotkeysContent",
        "padding": 16,
        "gap": 12,
        "children": [
          {
            "type": "row",
            "id": "captureHotkeyRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "captureHotkeyLabel",
                "textKey": "settings.hotkey.label",
                "width": 200
              },
              {
                "type": "keyChord",
                "id": "captureHotkey",
                "width": "fill"
              }
            ]
          },
          {
            "type": "row",
            "id": "copyHotkeyRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "copyHotkeyLabel",
                "textKey": "settings.hotkey.copy",
                "width": 200
              },
              {
                "type": "text",
                "id": "copyHotkeyValue",
                "textKey": "settings.hotkey.value.copy",
                "width": "fill"
              }
            ]
          },
          {
            "type": "row",
            "id": "saveHotkeyRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "saveHotkeyLabel",
                "textKey": "settings.hotkey.save",
                "width": 200
              },
              {
                "type": "text",
                "id": "saveHotkeyValue",
                "textKey": "settings.hotkey.value.save",
                "width": "fill"
              }
            ]
          },
          {
            "type": "row",
            "id": "cancelHotkeyRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "cancelHotkeyLabel",
                "textKey": "settings.hotkey.cancel",
                "width": 200
              },
              {
                "type": "text",
                "id": "cancelHotkeyValue",
                "textKey": "settings.hotkey.value.cancel",
                "width": "fill"
              }
            ]
          },
          {
            "type": "row",
            "id": "closePinHotkeyRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "closePinHotkeyLabel",
                "textKey": "settings.hotkey.close_pin",
                "width": 200
              },
              {
                "type": "text",
                "id": "closePinHotkeyValue",
                "textKey": "settings.hotkey.value.close_pin",
                "width": "fill"
              }
            ]
          },
          {
            "type": "text",
            "id": "hotkeyHelp",
            "textKey": "settings.hotkey.help"
          },
          {
            "type": "text",
            "id": "hotkeyStatus",
            "textKey": "settings.hotkey.status"
          }
        ]
      }
    },
    {
      "id": "captureStorage",
      "titleKey": "settings.storage.title",
      "content": {
        "type": "column",
        "id": "captureStorageContent",
        "padding": 16,
        "gap": 14,
        "children": [
          {
            "type": "row",
            "id": "colorStorageRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "colorStorageLabel",
                "textKey": "settings.storage.color",
                "width": 160
              },
              {
                "type": "edit",
                "id": "selectionBorderColor",
                "width": "fill"
              }
            ]
          },
          {
            "type": "row",
            "id": "formatStorageRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "formatStorageLabel",
                "textKey": "settings.storage.format",
                "width": 160
              },
              {
                "type": "select",
                "id": "defaultSaveFormat",
                "width": "fill"
              }
            ]
          },
          {
            "type": "row",
            "id": "qualityStorageRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "qualityStorageLabel",
                "textKey": "settings.storage.quality",
                "width": 160
              },
              {
                "type": "integer",
                "id": "jpegQuality",
                "minimum": 1,
                "maximum": 100,
                "slider": true,
                "width": "fill"
              }
            ]
          },
          {
            "type": "row",
            "id": "defaultHdrBrightnessRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "defaultHdrBrightnessLabel",
                "textKey": "settings.capture.default_brightness",
                "width": 160
              },
              {
                "type": "integer",
                "id": "defaultHdrBrightness",
                "minimum": 25,
                "maximum": 200,
                "slider": true,
                "width": "fill"
              }
            ]
          },
          {
            "type": "row",
            "id": "defaultMaskOpacityRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "defaultMaskOpacityLabel",
                "textKey": "settings.capture.default_mask",
                "width": 160
              },
              {
                "type": "integer",
                "id": "defaultMaskOpacity",
                "minimum": 0,
                "maximum": 90,
                "slider": true,
                "width": "fill"
              }
            ]
          },
          {
            "type": "text",
            "id": "captureDefaultsHelp",
            "textKey": "settings.capture.defaults_help"
          },
          {
            "type": "text",
            "id": "storageHelp",
            "textKey": "settings.storage.help"
          }
        ]
      }
    },
    {
      "id": "ocr",
      "titleKey": "settings.ocr.title",
      "content": {
        "type": "column",
        "id": "ocrContent",
        "padding": 16,
        "gap": 12,
        "children": [
          {
            "type": "select",
            "id": "ocrModel",
            "labelKey": "settings.ocr.model",
            "width": "fill"
          },
          {
            "type": "select",
            "id": "ocrLanguage",
            "labelKey": "settings.ocr.language",
            "width": "fill"
          },
          {
            "type": "text",
            "id": "ocrHelp",
            "textKey": "settings.ocr.help"
          }
        ]
      }
    },
    {
      "id": "translation",
      "titleKey": "settings.translation.title",
      "content": {
        "type": "column",
        "id": "translationContent",
        "padding": 16,
        "gap": 12,
        "children": [
          {
            "type": "text",
            "id": "translationPrivacy",
            "textKey": "settings.translation.privacy"
          },
          {
            "id": "translationList",
            "type": "row",
            "gap": 12,
            "children": [
              {
                "id": "translationInterfaces",
                "width": "fill",
                "visibleRows": 7,
                "columns": [
                  {
                    "textKey": "settings.translation.profile_name",
                    "width": "fill"
                  },
                  {
                    "textKey": "settings.translation.profile_type",
                    "width": 140
                  },
                  {
                    "textKey": "settings.translation.column_enabled",
                    "width": 80
                  }
                ],
                "labelKey": "settings.translation.interfaces",
                "type": "table"
              },
              {
                "id": "translationActions",
                "type": "column",
                "width": 112,
                "gap": 8,
                "children": [
                  {
                    "textKey": "settings.translation.add",
                    "id": "translation.add",
                    "type": "button"
                  },
                  {
                    "textKey": "settings.translation.edit",
                    "id": "translation.edit",
                    "type": "button"
                  },
                  {
                    "textKey": "settings.translation.delete",
                    "id": "translation.delete",
                    "type": "button"
                  },
                  {
                    "textKey": "settings.translation.up",
                    "id": "translation.up",
                    "type": "button"
                  },
                  {
                    "textKey": "settings.translation.down",
                    "id": "translation.down",
                    "type": "button"
                  }
                ]
              }
            ]
          },
          {
            "type": "select",
            "id": "translation.source_language",
            "labelKey": "settings.translation.source_language"
          },
          {
            "type": "select",
            "id": "translation.target_language",
            "labelKey": "settings.translation.target_language"
          },
          {
            "type": "text",
            "id": "translationCredentials",
            "textKey": "settings.translation.credentials"
          }
        ]
      }
    },
    {
      "id": "translationNetwork",
      "titleKey": "settings.translation.network.title",
      "content": {
        "type": "column",
        "id": "translationNetworkContent",
        "padding": 16,
        "gap": 12,
        "children": [
          {
            "type": "select",
            "id": "translation.network.proxy_mode",
            "labelKey": "settings.translation.network.proxy_mode"
          },
          {
            "type": "edit",
            "id": "translation.network.proxy_address",
            "labelKey": "settings.translation.network.proxy_address",
            "maxLength": 2048
          },
          {
            "type": "text",
            "id": "translationNetworkHelp",
            "textKey": "settings.translation.network.help"
          }
        ]
      }
    },
    {
      "id": "maintenance",
      "titleKey": "settings.maintenance.title",
      "content": {
        "type": "column",
        "id": "maintenanceContent",
        "padding": 16,
        "gap": 12,
        "children": [
          {
            "type": "text",
            "id": "maintenanceHelp",
            "textKey": "settings.maintenance.help"
          },
          {
            "type": "button",
            "id": "openLogDirectoryButton",
            "textKey": "settings.maintenance.open_directory"
          },
          {
            "type": "button",
            "id": "clearHistoricalLogsButton",
            "textKey": "settings.maintenance.clear_history"
          },
          {
            "type": "text",
            "id": "maintenanceStatus",
            "textKey": "settings.maintenance.status"
          },
          {
            "type": "button",
            "id": "restoreAllSettingsButton",
            "textKey": "settings.maintenance.restore_all"
          },
          {
            "type": "text",
            "id": "restoreAllHelp",
            "textKey": "settings.maintenance.restore_help"
          }
        ]
      }
    }
  ],
  "footer": {
    "leading": [
      {
        "type": "button",
        "id": "restoreDefaultsButton",
        "textKey": "settings.restore_page_defaults"
      },
      {
        "type": "button",
        "id": "reloadButton",
        "textKey": "settings.reload"
      }
    ],
    "trailing": [
      {
        "type": "button",
        "id": "acceptButton",
        "textKey": "settings.ok"
      },
      {
        "type": "button",
        "id": "cancelButton",
        "textKey": "settings.cancel"
      },
      {
        "type": "button",
        "id": "applyButton",
        "textKey": "settings.apply"
      }
    ]
  }
}
