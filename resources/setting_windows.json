{
  "schemaVersion": 1,
  "window": {
    "titleKey": "settings.title",
    "initialSize": [
      600,
      420
    ],
    "minSize": [
      480,
      280
    ],
    "resizable": true
  },
  "pages": [
    {
      "id": "general",
      "titleKey": "settings.general",
      "content": {
        "type": "column",
        "id": "generalContent",
        "padding": 16,
        "gap": 12,
        "children": [
          {
            "type": "select",
            "id": "languageSelector",
            "labelKey": "settings.language.label",
            "width": "fill"
          },
          {
            "type": "text",
            "id": "languageHelp",
            "textKey": "settings.language.help"
          },
          {
            "type": "checkbox",
            "id": "startupEnabled",
            "labelKey": "settings.startup.label"
          },
          {
            "type": "text",
            "id": "startupStatus",
            "textKey": "settings.startup.status"
          },
          {
            "type": "button",
            "id": "startupRepairButton",
            "textKey": "settings.startup.repair"
          }
        ]
      }
    },
    {
      "id": "hotkeys",
      "titleKey": "settings.hotkeys",
      "content": {
        "type": "column",
        "id": "hotkeysContent",
        "padding": 16,
        "gap": 12,
        "children": [
          {
            "type": "row",
            "id": "captureHotkeyRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "captureHotkeyLabel",
                "textKey": "settings.hotkey.label",
                "width": 200
              },
              {
                "type": "keyChord",
                "id": "captureHotkey",
                "width": "fill"
              }
            ]
          },
          {
            "type": "row",
            "id": "copyHotkeyRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "copyHotkeyLabel",
                "textKey": "settings.hotkey.copy",
                "width": 200
              },
              {
                "type": "text",
                "id": "copyHotkeyValue",
                "textKey": "settings.hotkey.value.copy",
                "width": "fill"
              }
            ]
          },
          {
            "type": "row",
            "id": "saveHotkeyRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "saveHotkeyLabel",
                "textKey": "settings.hotkey.save",
                "width": 200
              },
              {
                "type": "text",
                "id": "saveHotkeyValue",
                "textKey": "settings.hotkey.value.save",
                "width": "fill"
              }
            ]
          },
          {
            "type": "row",
            "id": "cancelHotkeyRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "cancelHotkeyLabel",
                "textKey": "settings.hotkey.cancel",
                "width": 200
              },
              {
                "type": "text",
                "id": "cancelHotkeyValue",
                "textKey": "settings.hotkey.value.cancel",
                "width": "fill"
              }
            ]
          },
          {
            "type": "row",
            "id": "closePinHotkeyRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "closePinHotkeyLabel",
                "textKey": "settings.hotkey.close_pin",
                "width": 200
              },
              {
                "type": "text",
                "id": "closePinHotkeyValue",
                "textKey": "settings.hotkey.value.close_pin",
                "width": "fill"
              }
            ]
          },
          {
            "type": "text",
            "id": "hotkeyHelp",
            "textKey": "settings.hotkey.help"
          },
          {
            "type": "text",
            "id": "hotkeyStatus",
            "textKey": "settings.hotkey.status"
          }
        ]
      }
    },
    {
      "id": "captureStorage",
      "titleKey": "settings.storage.title",
      "content": {
        "type": "column",
        "id": "captureStorageContent",
        "padding": 16,
        "gap": 14,
        "children": [
          {
            "type": "row",
            "id": "colorStorageRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "colorStorageLabel",
                "textKey": "settings.storage.color",
                "width": 160
              },
              {
                "type": "edit",
                "id": "selectionBorderColor",
                "width": "fill"
              }
            ]
          },
          {
            "type": "row",
            "id": "formatStorageRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "formatStorageLabel",
                "textKey": "settings.storage.format",
                "width": 160
              },
              {
                "type": "select",
                "id": "defaultSaveFormat",
                "width": "fill"
              }
            ]
          },
          {
            "type": "row",
            "id": "qualityStorageRow",
            "gap": 16,
            "children": [
              {
                "type": "text",
                "id": "qualityStorageLabel",
                "textKey": "settings.storage.quality",
                "width": 160
              },
              {
                "type": "integer",
                "id": "jpegQuality",
                "minimum": 1,
                "maximum": 100,
                "slider": true,
                "width": "fill"
              }
            ]
          },
          {
            "type": "text",
            "id": "storageHelp",
            "textKey": "settings.storage.help"
          }
        ]
      }
    },
    {
      "id": "ocr",
      "titleKey": "settings.ocr.title",
      "content": {
        "type": "column",
        "id": "ocrContent",
        "padding": 16,
        "gap": 12,
        "children": [
          {
            "type": "select",
            "id": "ocrModel",
            "labelKey": "settings.ocr.model",
            "width": "fill"
          },
          {
            "type": "select",
            "id": "ocrLanguage",
            "labelKey": "settings.ocr.language",
            "width": "fill"
          },
          {
            "type": "text",
            "id": "ocrHelp",
            "textKey": "settings.ocr.help"
          }
        ]
      }
    },
    {
      "id": "maintenance",
      "titleKey": "settings.maintenance.title",
      "content": {
        "type": "column",
        "id": "maintenanceContent",
        "padding": 16,
        "gap": 12,
        "children": [
          {
            "type": "text",
            "id": "maintenanceHelp",
            "textKey": "settings.maintenance.help"
          },
          {
            "type": "button",
            "id": "openLogDirectoryButton",
            "textKey": "settings.maintenance.open_directory"
          },
          {
            "type": "button",
            "id": "clearHistoricalLogsButton",
            "textKey": "settings.maintenance.clear_history"
          },
          {
            "type": "text",
            "id": "maintenanceStatus",
            "textKey": "settings.maintenance.status"
          },
          {
            "type": "button",
            "id": "restoreAllSettingsButton",
            "textKey": "settings.maintenance.restore_all"
          },
          {
            "type": "text",
            "id": "restoreAllHelp",
            "textKey": "settings.maintenance.restore_help"
          }
        ]
      }
    }
  ],
  "footer": {
    "leading": [
      {
        "type": "button",
        "id": "restoreDefaultsButton",
        "textKey": "settings.restore_page_defaults"
      },
      {
        "type": "button",
        "id": "reloadButton",
        "textKey": "settings.reload"
      }
    ],
    "trailing": [
      {
        "type": "button",
        "id": "acceptButton",
        "textKey": "settings.ok"
      },
      {
        "type": "button",
        "id": "cancelButton",
        "textKey": "settings.cancel"
      },
      {
        "type": "button",
        "id": "applyButton",
        "textKey": "settings.apply"
      }
    ]
  }
}
